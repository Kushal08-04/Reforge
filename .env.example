# ================================================
# REFORGE - Root Environment Configuration Example
# Copy to .env and configure for local or Docker Compose
# NEVER commit production credentials to source control
# ================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reforge?retryWrites=true&w=majority

# Port Configuration
PORT=5000
FRONTEND_PORT=5173
ML_PORT=8000

# Validation Engine Settings
SEMANTIC_ENGINE_VERSION=v0.2.0-hybrid
# Options: "rule_only" | "shadow" | "hybrid"
VALIDATION_MODE=shadow

# Classification Risk Thresholds (0.0 to 1.0)
RISK_THRESHOLD_SUSPICIOUS=0.3
RISK_THRESHOLD_INVALID=0.6

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173

# Python ML Microservice
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=2000
ML_ACTIVE_MODEL=isolation_forest

# Agentic ETL Repair Provider: "mock" | "gemini" | "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub Branch, Commit, and PR Integration
GITHUB_REPO=Kushal08-04/Reforge
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=
