# ==========================================
# REFORGE Server - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual .env file to source control.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reforge?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=REFORGE-Cluster
# Engine / rule versioning (recorded on every ValidationResult + AuditLog entry)
SEMANTIC_ENGINE_VERSION=v0.2.0-rules

# Classification thresholds (0-1 scale). suspicious <= score < invalid; below suspicious = valid.
RISK_THRESHOLD_SUSPICIOUS=0.3
RISK_THRESHOLD_INVALID=0.6

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
