# ==========================================
# REFORGE Server - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual .env file to source control.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=REFORGE-Cluster

# Engine & Decision Configuration
SEMANTIC_ENGINE_VERSION=v0.2.0-hybrid
# Validation Mode: "rule_only" | "shadow" | "hybrid"
VALIDATION_MODE=shadow

# Classification thresholds (0-1 scale)
RISK_THRESHOLD_SUSPICIOUS=0.3
RISK_THRESHOLD_INVALID=0.6

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Python ML Microservice
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=2000
ML_ACTIVE_MODEL=isolation_forest

# Agentic ETL Repair & LLM Provider: "mock" | "gemini" | "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub Branch & Pull Request Integration
GITHUB_REPO=Kushal08-04/Reforge
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=
